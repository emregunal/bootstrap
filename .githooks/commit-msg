#!/usr/bin/env bash
# commit-msg — a light sanity check on the commit message.
#
# Intentionally forgiving. It rejects an empty message, and it warns (without
# blocking) when the subject is not a Conventional Commit or runs long.
# Only the two hard failures below can actually stop a commit.
#
# Turn the convention check off per-repo:
#     git config ai-dev.commitMessageCheck false
# or for one commit:
#     COMMIT_MESSAGE_CHECK=false git commit -m "..."

set -Eeuo pipefail

MSG_FILE="${1:-}"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

# Everything except comments and the diff git appends under --verbose.
SUBJECT="$(grep -v '^#' "$MSG_FILE" | sed '/^diff --git /,$d' | sed '/^[[:space:]]*$/d' | head -1)"

if [ -z "$SUBJECT" ]; then
  echo "commit-msg: the commit message is empty." >&2
  exit 1
fi

# A merge or revert message is generated by git; leave it alone.
case "$SUBJECT" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

ENABLED="${COMMIT_MESSAGE_CHECK:-}"
if [ -z "$ENABLED" ]; then
  ENABLED="$(git config --get ai-dev.commitMessageCheck 2>/dev/null || echo true)"
fi
case "$ENABLED" in
  false|0|off|no) exit 0 ;;
esac

TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'

if ! printf '%s' "$SUBJECT" | grep -qE "^($TYPES)(\([a-z0-9._/-]+\))?!?: .+"; then
  echo "commit-msg: subject is not a Conventional Commit." >&2
  echo "  got:      $SUBJECT" >&2
  echo "  expected: <type>(<scope>): <description>" >&2
  echo "  types:    $(printf '%s' "$TYPES" | tr '|' ' ')" >&2
  echo "" >&2
  echo "  Disable with: git config ai-dev.commitMessageCheck false" >&2
  exit 1
fi

# Long subjects are a style problem, not an error — say so and move on.
LEN="${#SUBJECT}"
if [ "$LEN" -gt 72 ]; then
  echo "commit-msg: subject is $LEN characters; 72 or fewer reads better in a log." >&2
fi
exit 0
