# Copy to .env and fill in. .env is gitignored and the pre-commit hook refuses
# to let it through — never commit real values.
#
# Every variable here is optional. A missing key makes bootstrap warn and
# continue: on OpenCode the server is written disabled, on Claude Code and
# Codex it is skipped. Supply the key and run ai-dev-sync to enable it.
#
#   cp .env.example .env && chmod 600 .env

# Context7 — up-to-date library documentation.  OPTIONAL.
# The server works without a key (anonymous, rate-limited); a key raises the
# limits. Get one at https://context7.com
CONTEXT7_API_KEY=

# GitHub MCP server.  REQUIRED for this server.
# Without it the server is written to the config with "enabled": false, so it
# cannot fail on every OpenCode startup, and is skipped on the other agents.
# Create a fine-grained token at https://github.com/settings/tokens and scope
# it to the minimum you need — read-only repo access covers most use.
GITHUB_TOKEN=

# Filesystem MCP server root. The server can only read or write below this
# path. Resolved at install time and written into the config as an absolute
# path. Defaults to $HOME when unset; narrow it for a tighter blast radius:
#   MCP_FILESYSTEM_ROOT=/home/you/dev
MCP_FILESYSTEM_ROOT=
