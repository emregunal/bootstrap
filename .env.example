# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#
# Every variable here is optional. A missing key makes bootstrap warn and
# continue; the MCP server is still configured, it just will not authenticate.

# Context7 — up-to-date library documentation.
# Get a key at https://context7.com  (free tier available)
CONTEXT7_API_KEY=

# GitHub MCP server.
# A fine-grained personal access token: https://github.com/settings/tokens
# Scope it to the minimum you need — repo read is enough for most use.
GITHUB_TOKEN=

# Filesystem MCP server root. The server can only read/write below this path.
# Defaults to $HOME when unset. Narrow it if you want a tighter blast radius,
# e.g. MCP_FILESYSTEM_ROOT=/home/you/dev
MCP_FILESYSTEM_ROOT=
